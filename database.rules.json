{
  "rules": {
    ".read": false,
    ".write": false,
    "liveOrders": {
      "$orderId": {
        ".read": true,
        ".write": false,
        ".validate": "newData.hasChildren(['orderId', 'sellerId', 'status', 'amountPaise', 'expiresAt', 'lastUpdatedAt']) && newData.child('amountPaise').isNumber()"
      }
    },
    "sellerLiveStats": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": false
      }
    },
    "diagnosticsProbe": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
