rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection: sellers can read their own profile; role cannot be self-elevated to admin by client
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'seller'
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      match /settings/payment {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid)
          && request.resource.data.currency == 'INR'
          && request.resource.data.minimumAmountPaise is int
          && request.resource.data.maximumAmountPaise is int;
      }
    }

    // Payment Orders: seller can read own orders; privileged creation and status verification happen via backend
    match /paymentOrders/{orderId} {
      allow read: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // Transactions: read-only for owning seller or admin; written exclusively by backend verification engine
    match /transactions/{transactionId} {
      allow read: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // Reconciliation Cases: read-only from client; resolution mutations go through backend API with audit logging
    match /reconciliationCases/{caseId} {
      allow read: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // Audit Logs: restricted strictly to server-verified administrators
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
